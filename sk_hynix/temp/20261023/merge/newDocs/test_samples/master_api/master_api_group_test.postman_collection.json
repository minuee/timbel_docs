          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "console.log(JSON.stringify(b, null, 2));",
                  "if (b.data && b.data.roomId) { pm.collectionVariables.set('roomId', b.data.roomId); pm.collectionVariables.set('code', b.data.code); }"
