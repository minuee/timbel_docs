        {
          "name": "3-1 업로드 (방장, phone_A)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 같은 계정이 같은 fileName 을 두 번 올리면 중복으로 거부되므로 매번 새 이름",
                  "const d = new Date(), p = n => String(n).padStart(2, '0');",
                  "const ts = `${d.getFullYear()}${p(d.getMonth()+1)}${p(d.getDate())}_${p(d.getHours())}${p(d.getMinutes())}${p(d.getSeconds())}`;",
                  "pm.collectionVariables.set('fileNameHost', `A.Biz_m_rec_${ts}_A`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
