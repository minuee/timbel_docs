# pcapp-log-server 설정 — 이 파일을 .env 로 복사해서 쓴다.
#
#   cp .env.example .env
#
# .env 는 서버에서 손으로 관리한다. git 에 올리지 않는다.

# ---------------------------------------------------------------------
# 이미지
#   docker load 로 적재한 이미지와 정확히 일치해야 한다.
#   install.sh 를 쓰면 적재한 이미지를 읽어서 이 두 줄을 자동으로 맞춰준다.
#   직접 확인하려면:  docker images pcapp-log-server
# ---------------------------------------------------------------------
IMAGE_NAME=pcapp-log-server
IMAGE_VERSION=latest

# ---------------------------------------------------------------------
# 포트
#   HOST_PORT  서버에서 열리는 포트 (nginx 가 여기로 프록시한다)
#   PORT       컨테이너 안에서 바인드하는 포트 (바꿀 필요 없다)
# ---------------------------------------------------------------------
HOST_PORT=9996
PORT=9996
HOST=0.0.0.0

# ---------------------------------------------------------------------
# 컨테이너 실행 계정
#   서버 계정(aimm)의 uid:gid. install.sh 가 자동으로 채운다.
#   직접 확인하려면:  id -u aimm ; id -g aimm
# ---------------------------------------------------------------------
RUN_UID=1000
RUN_GID=1000

# ---------------------------------------------------------------------
# 로그 파일 (장기 보관)
#   LOG_HOST_DIR        호스트 경로. 날짜별 파일 pcapp-YYYY-MM-DD.log 가 쌓인다.
#                       소유권은 위 RUN_UID:RUN_GID 와 같아야 한다.
#   LOG_FILE_ENABLED    0 이면 파일에 쓰지 않고 stdout(Dozzle)에만 출력한다.
#   LOG_RETENTION_DAYS  이 일수가 지난 파일은 서버가 1시간마다 지운다. 0 이면 지우지 않는다.
#   LOG_TIMEZONE        파일명 날짜와 ts 의 기준 시간대.
# ---------------------------------------------------------------------
LOG_HOST_DIR=/data/timblo/pcapp-log-server-logs
LOG_FILE_ENABLED=1
LOG_RETENTION_DAYS=90
LOG_TIMEZONE=Asia/Seoul

# ---------------------------------------------------------------------
# 요청 제한
#   MAX_BODY_BYTES           요청 하나의 최대 크기 (기본 1MB)
#   MAX_ENTRIES_PER_REQUEST  요청 하나에 담을 수 있는 로그 줄 수 (앱은 100줄씩 보낸다)
# ---------------------------------------------------------------------
MAX_BODY_BYTES=1048576
MAX_ENTRIES_PER_REQUEST=500
