{
  "name": "timbloRecApp",
  "version": "0.0.1",
  "description": "Cross-platform meeting recorder with native audio helpers",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electronmon . --dev",
    "build": "electron-builder --publish never",
    "build-helper": "cd src/helpers/windows && build.bat",
    "sign-helper": "./scripts/sign-helper.sh",
    "register-protocol": "node scripts/register-protocol-manual.js"
  },
  "keywords": [
    "electron",
    "audio",
    "recording",
    "meeting"
  ],
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "electron": "^38.0.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "electronmon": "^2.0.3"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.3.9",
    "uuid": "^9.0.1"
  },
  "build": {
    "appId": "net.timbel.timblo.recapp",
    "productName": "timbloRecApp",
    "protocols": [
      {
        "name": "timbloRecApp",
        "schemes": [
          "timbloRecApp"
        ]
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "afterPack": "./scripts/afterPack.js",
    "afterSign": "./scripts/afterSign.js",
    "directories": {
      "output": "dist",
      "buildResources": "electron-resources"
    },
    "files": [
      "src/**/*",
      "!src/helpers/**/*.cpp",
      "!src/helpers/**/*.h",
      "!src/helpers/**/obj/**",
      "!src/helpers/macos/AudioHelper/**"
    ],
    "extraFiles": [
      {
        "from": "src/helpers/windows/AudioHelper.exe",
        "to": "helpers/windows/AudioHelper.exe"
      },
      {
        "from": "src/helpers/macos/AudioHelper.app",
        "to": "helpers/macos/AudioHelper.app",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "electron-resources/logo.ico"
    },
    "mac": {
      "icon": "electron-resources/logo.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "이 앱은 회의 녹음을 위해 마이크 접근 권한이 필요합니다.",
        "NSSystemAdministrationUsageDescription": "시스템 오디오 녹음을 위해 권한이 필요합니다.",
        "NSScreenCaptureUsageDescription": "회의의 시스템 오디오를 녹음하기 위해 화면 기록 권한이 필요합니다."
      },
      "identity": "Apple Development: lena47@naver.com (LCK54NQ9AW)",
      "notarize": {
        "teamId": "7H4827QYPR"
      }
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://update-server.invalid/timbloRecApp"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "SKHynixRecApp",
      "uninstallDisplayName": "SKHynixRecApp"
    }
  },
  "electronmon": {
    "patterns": [
      "!src/helpers/**",
      "docs/**"
    ]
  }
}
