# ── JWT 서명 ────────────────────────────────────────────────
JWT_ISSUER=timbel-portal
JWT_AUDIENCE=timbel-apps
JWT_KID=timbel-on-premise-v1
JWT_PRIVATE_KEY_PATH=keys/private.pem
# 키 회전 중에만 사용. "kid:공개키경로,kid2:경로2"
JWT_RETIRED_PUBLIC_KEYS=

# ── 수명 정책 (PPT 부록 C — 보안팀·현업 합의 후 확정) ───────
# 현행 정책값 60분/14일 ↔ 실측 20분/65분 불일치. 아래 값으로 일원화한다.
ACCESS_TTL_SECONDS=600
REFRESH_TTL_SECONDS=86400
REFRESH_GRACE_SECONDS=20
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=43200

# ── 쿠키 ────────────────────────────────────────────────────
COOKIE_ENABLED=true
COOKIE_SECURE=false          # 운영 HTTPS 는 반드시 true
COOKIE_SAMESITE=lax          # 크로스 출처면 none + secure
COOKIE_PERSISTENT=false      # false = 세션 쿠키(브라우저 닫으면 폐기)
CSRF_ENABLED=true

# ── 인프라 ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=auth
CORS_ALLOW_ORIGINS=http://localhost:3000,http://106.242.165.142:3000
