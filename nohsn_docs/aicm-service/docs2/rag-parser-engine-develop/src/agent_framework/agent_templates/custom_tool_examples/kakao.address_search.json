{
  "id": "kakao.address_search",
  "name": "kakao.address_search",
  "display_name": "Kakao 주소 검색",
  "description": "Kakao Local API 의 주소 검색(address.json)으로 지번/도로명 주소를 좌표(위경도) 및 상세 정보로 변환합니다. REST API 키를 Authorization 헤더에 포함합니다.",
  "category": "정보/검색",
  "vendor": "Kakao",
  "vendor_url": "https://developers.kakao.com/docs/latest/ko/local/dev-guide#address-coord",
  "endpoint_url": "https://dapi.kakao.com/v2/local/search/address.json",
  "method": "GET",
  "auth_headers": {
    "Authorization": "KakaoAK <YOUR_REST_API_KEY>"
  },
  "input_schema": {
    "type": "object",
    "required": ["query"],
    "properties": {
      "query": {
        "type": "string",
        "description": "검색할 주소 (예: 서울시 중구 세종대로 110)"
      },
      "analyze_type": {
        "type": "string",
        "enum": ["similar", "exact"],
        "default": "similar",
        "description": "검색 방식 (similar: 유사 검색, exact: 정확 검색)"
      },
      "page": {
        "type": "integer",
        "default": 1,
        "minimum": 1,
        "maximum": 45,
        "description": "결과 페이지 번호"
      },
      "size": {
        "type": "integer",
        "default": 10,
        "minimum": 1,
        "maximum": 30,
        "description": "한 페이지 결과 수"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "description": "Kakao Local 응답 ({\"documents\": [{\"address_name\": \"...\", \"x\": \"경도\", \"y\": \"위도\"}], \"meta\": {\"total_count\": ...}})"
  },
  "risk_metadata": {
    "side_effect": "read",
    "scope": "any",
    "requires_sender_tier": "member",
    "requires_confirm": false,
    "conflict_check": []
  },
  "security": {
    "direction": "outbound_query",
    "signature_method": "static_secret_token",
    "verify_header": "Authorization",
    "replay_protection": "none",
    "tls_required": true,
    "ip_allowlist_supported": false,
    "notes": "REST API 키는 Authorization 헤더 'KakaoAK <key>' 형태. 노출 시 카카오 콘솔에서 재발급. 플랫폼(도메인) 등록 시 origin 제한 가능."
  },
  "operational_notes": {
    "rate_limit": "무료 티어: 일 300,000건, QPS 10",
    "retry_semantics": "5xx 지수 백오프, 429 시 retry-after 준수",
    "response_sla_sec": null,
    "cost_label": "free (상용 시 카카오 비즈니스 신청)",
    "biz_account_required": false
  },
  "setup_instructions": [
    "1. https://developers.kakao.com 로그인 → '내 애플리케이션' → '애플리케이션 추가하기'",
    "2. 앱 이름(예: Locus), 사업자명 입력 후 저장",
    "3. 앱 선택 → '앱 키' 탭 → 'REST API 키' 복사",
    "4. auth_headers 의 Authorization 값: 'KakaoAK ' + REST_API_KEY",
    "5. 플랫폼 등록: '플랫폼' 탭 → Web → 서비스 도메인 등록 (localhost 도 허용 가능)",
    "6. 무료 티어: 일 300,000건 QPS 10 — 상용 서비스는 카카오 비즈니스 신청 필요",
    "7. 보안: REST API 키는 KMS / config_encrypted 저장. 플랫폼 도메인 제한으로 origin 절도 방지."
  ]
}
