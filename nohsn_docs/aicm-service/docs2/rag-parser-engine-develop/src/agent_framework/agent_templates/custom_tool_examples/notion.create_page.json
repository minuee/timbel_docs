{
  "id": "notion.create_page",
  "name": "notion.create_page",
  "display_name": "Notion 페이지 생성",
  "description": "Notion API 로 지정한 데이터베이스 또는 페이지 하위에 새 페이지를 생성합니다. Notion Integration 을 생성하고 Bearer 토큰을 발급받아 사용합니다.",
  "category": "협업/CRM",
  "vendor": "Notion",
  "vendor_url": "https://developers.notion.com/reference/post-page",
  "endpoint_url": "https://api.notion.com/v1/pages",
  "method": "POST",
  "auth_headers": {
    "Authorization": "Bearer <YOUR_NOTION_INTEGRATION_TOKEN>",
    "Notion-Version": "2022-06-28",
    "Content-Type": "application/json"
  },
  "input_schema": {
    "type": "object",
    "required": ["parent", "properties"],
    "properties": {
      "parent": {
        "type": "object",
        "description": "상위 데이터베이스 또는 페이지 지정",
        "properties": {
          "database_id": {
            "type": "string",
            "description": "데이터베이스 ID (데이터베이스 하위 페이지 생성 시)"
          },
          "page_id": {
            "type": "string",
            "description": "상위 페이지 ID (일반 페이지 하위 생성 시)"
          }
        }
      },
      "properties": {
        "type": "object",
        "description": "페이지 속성 (데이터베이스 스키마에 맞게 작성)",
        "example": {
          "Name": {
            "title": [{"text": {"content": "새 페이지 제목"}}]
          }
        }
      },
      "children": {
        "type": "array",
        "description": "페이지 본문 블록 목록 (옵션)",
        "items": {
          "type": "object"
        }
      }
    }
  },
  "output_schema": {
    "type": "object",
    "description": "생성된 Notion 페이지 객체 ({\"id\": \"page_id\", \"url\": \"https://notion.so/...\", ...})"
  },
  "risk_metadata": {
    "side_effect": "write",
    "scope": "any",
    "requires_sender_tier": "verified",
    "requires_confirm": false,
    "conflict_check": []
  },
  "security": {
    "direction": "outbound",
    "signature_method": "Bearer",
    "verify_header": "Authorization",
    "replay_protection": "none",
    "tls_required": true,
    "ip_allowlist_supported": false,
    "notes": "Internal Integration Token 은 워크스페이스 단위 — 'secret_' prefix. 페이지/DB 마다 명시적 'Connections' 추가 필수. 노출 시 https://www.notion.so/my-integrations 에서 즉시 재발급."
  },
  "operational_notes": {
    "rate_limit": "평균 3 req/sec, burst 시 429",
    "retry_semantics": "429 시 Retry-After 준수, 5xx 지수 백오프",
    "response_sla_sec": null,
    "cost_label": "free (Notion Personal/Plus 모두 API 사용 가능)",
    "biz_account_required": false
  },
  "setup_instructions": [
    "1. https://www.notion.so/my-integrations 에서 '+ 새 통합' 클릭",
    "2. 통합 이름(예: Locus), 워크스페이스 선택 후 저장",
    "3. '내부 통합 토큰' 복사 (secret_로 시작하는 문자열)",
    "4. auth_headers 의 Authorization: Bearer <token> 에 복사한 토큰 입력",
    "5. Notion 에서 연결할 데이터베이스/페이지 열기 → 우상단 '...' → '연결' → 생성한 통합 추가",
    "6. 데이터베이스 ID 확인: 데이터베이스 URL 의 workspace/... 뒤 32자리 (하이픈 없이)",
    "7. 보안: Integration Token 은 KMS / config_encrypted. 노출 시 Notion 대시보드에서 즉시 회전. Notion-Version 헤더 고정 권장 (스키마 변경 회귀 방지)."
  ]
}
