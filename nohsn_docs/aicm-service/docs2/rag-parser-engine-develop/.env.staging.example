# Locus-KMS staging .env (port 5200대로 격리)
# 통합 Locus 가 5100대 점유 중 — 충돌 회피.

LUCAS_PRODUCT=kms
APP_ENV=staging
LOG_LEVEL=INFO

# 무인증 모드 (사용자 명시) — staging 측정용
LUCAS_AUTH_DISABLED=true
LUCAS_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
LUCAS_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# Swagger
ENV=dev
ENABLE_SWAGGER=true
SWAGGER_AUTH_MODE=none
SWAGGER_IP_ALLOWLIST=

# Intent classification (agent_framework 없음)
ENABLE_INTENT_CLASSIFICATION=false
KMS_CROSS_BRAND_FILTER_ENABLED=false
KMS_POST_GEN_FILTER_ENABLED=true

# ============ Port override (충돌 회피 — 5200대) ============
LUCAS_KMS_API_PORT=5201
LUCAS_KMS_PG_PORT=5210
LUCAS_KMS_QDRANT_REST_PORT=5211
LUCAS_KMS_QDRANT_GRPC_PORT=5212
LUCAS_KMS_ES_PORT=5213
LUCAS_KMS_KAFKA_PORT=5214
LUCAS_KMS_REDIS_PORT=5215
LUCAS_KMS_MINIO_API_PORT=5216
LUCAS_KMS_MINIO_CONSOLE_PORT=5217

# ============ PostgreSQL (격리 DB) ============
POSTGRES_DB=locus_kms_staging
POSTGRES_USER=lucas
POSTGRES_PASSWORD=CHANGE-ME-staging
KMS_DB_ROLE_API=migration
KMS_DB_ROLE_WORKER=migration
KMS_APP_PASSWORD=lucas_app_staging_password
KMS_SUPERADMIN_PASSWORD=lucas_super_staging_password
RLS_ENFORCE=false

# ============ Qdrant / ES / Kafka / Redis / MinIO ============
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

ELASTICSEARCH_URL=http://elasticsearch:9200
ES_JAVA_OPTS=-Xms512m -Xmx512m

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP_SMALL=lucas-staging-small
KAFKA_CONSUMER_GROUP_LARGE=lucas-staging-large
KAFKA_AUTO_OFFSET_RESET=earliest

REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=lucas_staging_minio_password
MINIO_SECURE=false
MINIO_DOCUMENT_BUCKET=lucas-documents
MINIO_INTERMEDIATE_BUCKET=lucas-intermediate
MINIO_IMAGE_BUCKET=lucas-images

# ============ Embedding ============
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=16

# ============ LLM — 모드 A (SSH tunnel 공유 — 통합과 동일 vLLM) ============
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cuda
RERANKER_URL=http://host.docker.internal:7125/rerank
EMBEDDING_PROXY_URL=http://host.docker.internal:7125

VLLM_URL=http://host.docker.internal:7120/v1
VLLM_MODEL=gemma-4-31B-it
VLLM_API_KEY=
SLLM_GEMMA_URL=http://host.docker.internal:7120/v1
SLLM_GEMMA_MODEL=gemma-4-31B-it
KMS_ACK_MODEL_URL=http://host.docker.internal:7120/v1
KMS_ACK_MODEL=gemma-4-31B-it

# ============ 인증 ============
AUTH_PROVIDER=jwt
JWT_SECRET_KEY=CHANGE-ME-staging-jwt
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CITATION_HMAC_SECRET=CHANGE-ME-staging-citation
CITATION_HMAC_TTL_SECS=43200

# ============ 파일 / pipeline ============
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=500
LARGE_DOCUMENT_THRESHOLD_MB=50
PIPELINE_PARALLEL_WORKERS_SMALL=2
PIPELINE_PARALLEL_WORKERS_LARGE=1
PIPELINE_EARLY_DIVERT_ENABLED=true

# ============ Assist Stream ============
ASSIST_MAX_ANSWER_TOKENS=320
ASSIST_INTENT_TIMEOUT_MS=2000
ASSIST_SEARCH_TIMEOUT_MS=8000
ASSIST_DISTILL_TIMEOUT_MS=5000
ASSIST_GEN_FIRST_TOKEN_TIMEOUT_MS=10000
ASSIST_GEN_TOTAL_TIMEOUT_MS=30000
ASSIST_TOTAL_TIMEOUT_MS=40000

# ============ HF cache ============
HF_CACHE_DIR=./hf_cache
HF_TOKEN=
