# ============================================================
# Lucas-KMS — Standalone 환경 변수 (공공 SaaS 배포 예시)
# 사용:
#   cp .env.lucas-kms.example .env
#   docker compose -f docker-compose.lucas-kms.yml up -d
# ============================================================

# === 제품 식별 ===
# Lucas-KMS 단독 배포 — main_kms factory + worker registry 차단의 source of truth.
LUCAS_PRODUCT=kms

# === 공통 ===
APP_ENV=production
LOG_LEVEL=INFO

# === Lucas-KMS 무인증 모드 (2026-05-19 사용자 명시 default ON) ===
# 키 없이 운영 — JWT/X-API-Key/Swagger auth 모두 bypass. 내부 테스트/시연 용도.
# *주의*: 외부 노출 운영 환경에서는 반드시 false 로 전환 + JWT_SECRET_KEY 강한 값 설정.
LUCAS_AUTH_DISABLED=true
# 무인증 모드 시 기본 tenant_id / user_id (UUID 형식). 운영 데이터와 충돌 없는 값 권장.
LUCAS_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
LUCAS_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# === Lucas-KMS 운영 보안 (외부 노출 차단) ===
# Phase 4 T4.6 — Swagger 운영 정책 (src/common/swagger_policy.py).
# ENV=prod 또는 production → ENABLE_SWAGGER default off. dev/test/staging → default on.
# 명시적 ENABLE_SWAGGER 가 우선.
ENV=dev
ENABLE_SWAGGER=true
# 인증 모드: none / basic / jwt.
#   - basic: SWAGGER_BASIC_USER + SWAGGER_BASIC_PASSWORD 검증 (HTTP Basic Auth)
#   - jwt  : Authorization: Bearer ... 헤더 존재 검증 (운영 망 분리 + IP allowlist 병행 권장)
#   - none : 인증 없음 (dev 편의 — 운영 비권장)
# 무인증 모드 (LUCAS_AUTH_DISABLED=true) 시 본 값은 자동 bypass.
SWAGGER_AUTH_MODE=none
# IP allowlist (comma-separated CIDR). 빈값 → 검사 없음. 운영 권장 예: "10.0.0.0/8,192.168.0.0/16".
SWAGGER_IP_ALLOWLIST=
# basic 모드 전용 — auth_mode=basic 일 때 둘 다 필수.
SWAGGER_BASIC_USER=
SWAGGER_BASIC_PASSWORD=
# agent_framework 미포함 환경 — intent classification 비활성 (KMS 단독 모드 필수).
ENABLE_INTENT_CLASSIFICATION=false
# KMS 분리 절칙 — 루카스 측 cross-brand post-filter 비활성 (KMS retrieval 결과 보존).
KMS_CROSS_BRAND_FILTER_ENABLED=false
KMS_POST_GEN_FILTER_ENABLED=true

# === PostgreSQL (KMS RLS 운영) ===
POSTGRES_DB=kms_pipeline
POSTGRES_USER=kms
POSTGRES_PASSWORD=change-this-to-strong-random-password
# DB role — API/worker 는 'app' (NOBYPASSRLS). migration container 는 자동으로 'migration'.
KMS_DB_ROLE_API=app
KMS_DB_ROLE_WORKER=app
# 분리 role 비밀번호 (alembic 스크립트가 생성). 운영에서 강한 값으로 교체.
KMS_APP_PASSWORD=change-this-app-role-password
KMS_SUPERADMIN_PASSWORD=change-this-superadmin-role-password
# RLS enforce — 운영에서 반드시 true. tenant 격리 default-deny.
RLS_ENFORCE=true
# compose 가 자동 조립 (위 값 기준). 외부 PG 사용 시 직접 override:
# DATABASE_URL=postgresql+asyncpg://kms:password@external-pg:5432/kms_pipeline

# === Qdrant ===
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_GRPC_PORT=6334

# === Elasticsearch ===
ELASTICSEARCH_URL=http://elasticsearch:9200
# JVM heap (운영 RAM 에 맞춰 조정).
ES_JAVA_OPTS=-Xms1g -Xmx1g

# === Kafka ===
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP_SMALL=aicm-pipeline
KAFKA_CONSUMER_GROUP_LARGE=aicm-pipeline-large
KAFKA_AUTO_OFFSET_RESET=earliest

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === MinIO (Object Storage) ===
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-strong-minio-password
MINIO_SECURE=false
MINIO_DOCUMENT_BUCKET=kms-documents
MINIO_INTERMEDIATE_BUCKET=kms-intermediate
MINIO_IMAGE_BUCKET=kms-images

# === Embedding (BGE-M3 GPU) ===
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32

# ===================================================================
# LLM + Reranker — 두 배포 모드 중 선택
# ===================================================================
# [모드 A] 기본 — SSH tunnel / 외부 vLLM endpoint 사용
#   $ docker compose -f docker-compose.lucas-kms.yml up -d
#   - host.docker.internal:7120 (B200 SSH tunnel) / 운영 서버 endpoint
#   - 본 컨테이너 stack 에 vllm/reranker *미포함*
#
# [모드 B] 자체 GPU 보유 — local-llm profile 로 컨테이너 내부 vllm/reranker
#   $ docker compose -f docker-compose.lucas-kms.yml --profile local-llm up -d
#   - 같은 stack 에 vllm + reranker 서비스 추가 (NVIDIA GPU 1장 이상 필요)
#   - 아래 VLLM_URL / RERANKER_URL 을 *컨테이너명* 으로 교체:
#       VLLM_URL=http://vllm:8000/v1
#       RERANKER_URL=http://reranker:8000/rerank
#   - VLLM_MODEL_ID / VLLM_MAX_MODEL_LEN / VLLM_GPU_MEM_UTIL / VLLM_MAX_NUM_SEQS / HF_TOKEN 도 .env 에 추가
# ===================================================================

# === Reranker endpoint ===
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cuda
# 모드 A 기본 — SSH tunnel host.docker.internal:7125
# 모드 B 사용 시: RERANKER_URL=http://reranker:8000/rerank
RERANKER_URL=http://host.docker.internal:7125/rerank
EMBEDDING_PROXY_URL=http://host.docker.internal:7125

# === vLLM (Gemma-4-31B-it) endpoint ===
# 모드 A 기본 — SSH tunnel host.docker.internal:7120 (B200 :8000)
# 모드 B 사용 시: VLLM_URL=http://vllm:8000/v1
VLLM_URL=http://host.docker.internal:7120/v1
VLLM_MODEL=gemma-4-31B-it
VLLM_API_KEY=
SLLM_GEMMA_URL=http://host.docker.internal:7120/v1
SLLM_GEMMA_MODEL=gemma-4-31B-it
KMS_ACK_MODEL_URL=http://host.docker.internal:7120/v1
KMS_ACK_MODEL=gemma-4-31B-it

# === 모드 B (local-llm profile) 전용 ===
# vllm 컨테이너에 전달되는 모델/GPU 설정. 모드 A 에서는 무시됨.
VLLM_MODEL_ID=cyankiwi/gemma-4-31B-it-AWQ-4bit
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEM_UTIL=0.78
VLLM_MAX_NUM_SEQS=4
HF_TOKEN=

# === 인증 (JWT — Lucas-KMS API 외부 노출 보안 필수) ===
AUTH_PROVIDER=jwt
# 운영에서 무작위 32 byte 이상 생성:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-strong-random-jwt-secret-min-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# === Citation HMAC (D41 — guest landing) ===
CITATION_HMAC_SECRET=change-this-citation-hmac-secret-must-be-at-least-32-bytes
CITATION_HMAC_TTL_SECS=43200

# === OpenAI (선택 — fallback / GPT-5.5 검증 등) ===
# 본 키가 비어 있으면 OpenAI 의존 기능 (fallback / 검증) 자동 비활성.
OPENAI_API_KEY=

# === 파일 저장 ===
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=500
LARGE_DOCUMENT_THRESHOLD_MB=50

# === Pipeline 워커 동시성 ===
PIPELINE_PARALLEL_WORKERS_SMALL=4
PIPELINE_PARALLEL_WORKERS_LARGE=1
PIPELINE_EARLY_DIVERT_ENABLED=true
PIPELINE_LARGE_TOPIC_ENABLED=true
PIPELINE_SMALL_SIZE_MB_THRESHOLD=2

# === Assist Stream (외부 앱 SSE 진입점) ===
ASSIST_MAX_ANSWER_TOKENS=320
ASSIST_INTENT_TIMEOUT_MS=2000
ASSIST_SEARCH_TIMEOUT_MS=8000
ASSIST_DISTILL_TIMEOUT_MS=5000
ASSIST_GEN_FIRST_TOKEN_TIMEOUT_MS=10000
ASSIST_GEN_TOTAL_TIMEOUT_MS=30000
ASSIST_TOTAL_TIMEOUT_MS=40000
ASSIST_MAX_CONCURRENT_PER_TENANT=8

# === HuggingFace 캐시 (모델 다운로드 영속화) ===
HF_CACHE_DIR=./hf_cache

# === 포트 매핑 (외부 충돌 시 override) ===
# LUCAS_KMS_API_PORT=5101
# LUCAS_KMS_FRONTEND_PORT=5102   # nginx frontend (static + /api 프록시)
# LUCAS_KMS_PG_PORT=5110
# LUCAS_KMS_QDRANT_REST_PORT=5111
# LUCAS_KMS_QDRANT_GRPC_PORT=5112
# LUCAS_KMS_ES_PORT=5113
# LUCAS_KMS_KAFKA_PORT=5114
# LUCAS_KMS_REDIS_PORT=5115
# LUCAS_KMS_MINIO_API_PORT=5116
# LUCAS_KMS_MINIO_CONSOLE_PORT=5117

# === 컨테이너 리소스 제한 (호스트 swap thrashing 차단) ===
# LUCAS_KMS_API_MEM=3g
# LUCAS_KMS_API_CPUS=2.0
# LUCAS_KMS_WORKER_LARGE_MEM=6g
# LUCAS_KMS_WORKER_LARGE_CPUS=4.0
# LUCAS_KMS_WORKER_SMALL_MEM=2g
# LUCAS_KMS_WORKER_SMALL_CPUS=2.0
